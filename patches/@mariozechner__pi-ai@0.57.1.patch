@@ -0,0 +1,40 @@
+// Private, bounded framing for the explicitly scoped legal observer only.
+// The ordinary provider parser remains unchanged when the observer is absent.
+export async function* parseLegalEvidenceSSE(response, observer) {
+    const reader = response.body.getReader();
+    let total = 0, frameBuffer = new Uint8Array(1024), frameLength = 0, lineLength = 0, lastByte = 0, terminalCount = 0;
+    try {
+        while (true) {
+            const { done, value } = await reader.read();
+            if (done) break;
+            total += value.byteLength;
+            if (total > 16000000) throw new Error("legal-evidence-limit");
+            await observer.onChunk(value);
+            for (let i = 0; i < value.length; i++) {
+                if (frameLength === frameBuffer.length) {
+                    const grown = new Uint8Array(Math.min(16000000, frameBuffer.length * 2));
+                    grown.set(frameBuffer); frameBuffer = grown;
+                }
+                frameBuffer[frameLength++] = value[i];
+                if (value[i] !== 10) { lineLength++; lastByte = value[i]; continue; }
+                const boundary = lineLength === 0 || (lineLength === 1 && lastByte === 13);
+                lineLength = 0;
+                if (!boundary) continue;
+                const frame = frameBuffer.slice(0, frameLength); frameLength = 0;
+                const text = new TextDecoder("utf-8", { fatal: true }).decode(frame);
+                const data = text.split(/\r?\n/).filter(l => l.startsWith("data:")).map(l => l.slice(5).replace(/^ /, "")).join("\n");
+                if (!data || data === "[DONE]") continue;
+                const event = JSON.parse(data);
+                if (!event || typeof event !== "object" || Array.isArray(event)) throw new Error("legal-evidence-frame");
+                if (event.type === "response.completed" || event.type === "response.done") {
+                    if (++terminalCount !== 1) throw new Error("legal-evidence-duplicate-terminal");
+                    await observer.onTerminal(frame);
+                }
+                yield event;
+            }
+        }
+        if (frameLength || lineLength || terminalCount !== 1) throw new Error("legal-evidence-incomplete-stream");
+    } finally {
+        try { await reader.cancel(); } finally { reader.releaseLock(); }
+    }
+}
