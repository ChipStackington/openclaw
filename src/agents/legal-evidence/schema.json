          "$ref": "#/definitions/Hash"
        },
        "preparedAt": {
          "$ref": "#/definitions/Time"
        },
        "phase": {
          "enum": ["prepared", "bound", "submitted", "uncertain", "completed", "failed"]
        },
        "preparedMaterial": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Blob"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "engineReceiptHash": {
          "$ref": "#/definitions/Hash"
        },
        "importedMaterial": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Blob"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "assembledText": {
          "$ref": "#/definitions/Blob"
        },
        "completedAt": {
          "$ref": "#/definitions/Time"
        },
        "holdReason": {
          "enum": [
            "none",
            "missing-evidence",
            "authorization-lost",
            "source-stale",
            "contract-stale",
            "output-invalid",
            "provider-held",
            "transport-unknown",
            "storage-unavailable"
          ]
        }
      },
      "required": [
        "version",
        "id",
        "revision",
        "captureOrigin",
        "binding",
        "bindingHash",
        "preparedAt",
        "phase",
        "preparedMaterial"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "completed"
              }
            }
          },
          "then": {
            "required": ["engineReceiptHash", "importedMaterial", "assembledText", "completedAt"],
            "properties": {
              "importedMaterial": {
                "minItems": 1
              },
              "holdReason": {
                "const": "none"
              }
            }
          }
        }
      ]
